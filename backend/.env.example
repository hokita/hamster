# Comma-separated Google account email addresses authorized to use the app.
ALLOWED_EMAILS=you@gmail.com
FIREBASE_PROJECT_ID=demo-hamster
FRONTEND_URL=http://localhost:5173
PORT=8080
FIRESTORE_EMULATOR_HOST=localhost:8081
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# Gemini API key used to generate bookmark summaries. Deliberately left commented out: copying
# this file should give you a working local setup with summarization cleanly disabled (the
# endpoint returns 503 and every bookmark page shows its empty state). A placeholder value here
# would look configured to the backend, so every save would fetch its article and then fail
# against Gemini with invalid credentials. Uncomment and paste a real key to enable summaries.
# GEMINI_API_KEY=
